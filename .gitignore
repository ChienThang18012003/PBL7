# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
ENV/
env/
.venv/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore editor configs
.vscode/
.idea/

# Ignore logs
*.log

# Ignore dotenv or secrets
.env

# Byte-compiled / optimized / DLL files
*.pyc
*.pyo
*.pyd

# Ignore test output
htmlcov/
.coverage
.cache
nosetests.xml
coverage.xml
*.cover

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/
